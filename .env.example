PORT=10000
NODE_ENV=production

# Long random secret, 32+ characters. Never commit the real value.
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters

# Render Free has an ephemeral filesystem. This SQLite path is suitable for testing only.
DB_FILE=./data/xcapital.db

# Email verification through HTTPS (works with Render Free).
# Create a free Resend account and add the API key in Render Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
MAIL_FROM=X-CAPITAL <onboarding@resend.dev>

# Real deposit addresses: configure each supported network separately.
USDT_TRC20_ADDRESS=
USDC_ERC20_ADDRESS=
BTC_ADDRESS=

# TEMPORARY REFERENCE VALUES ONLY. Replace the server MARKET_DATA layer with a verified provider/NAV service before production.
TSLA_PRICE=248.12
TSLA_CHANGE_24H=0
SPACEX_PRICE=1248.75
SPACEX_CHANGE_24H=0
XAI_PRICE=12432.67
XAI_CHANGE_24H=0
NEURALINK_PRICE=7.24
NEURALINK_CHANGE_24H=0
STARLINK_PRICE=18.76
STARLINK_CHANGE_24H=0

# First admin account is created by running locally: ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD='strong-password' node scripts/create-admin.js
